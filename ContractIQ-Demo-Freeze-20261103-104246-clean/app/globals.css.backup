g:22px;box-shadow:0 20px 70px #11182735}.modal-heading{display:flex;justify-content:space-between;align-items:flex-start}.modal-heading h2{font:700 17px Manrope;margin:0}.modal-heading p{font-size:10px;color:#8e97a7;margin:6px 0 0}.dropzone{margin:22px 0 14px;border:1.5px dashed #d9d6f2;background:#fbfaff;border-radius:11px;min-height:215px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:9px;cursor:pointer}.upload-symbol{height:45px;width:45px;border-radius:12px;background:#eeebff;color:#7767dc;display:grid;place-items:center;margin-bottom:3px}.dropzone b{font-size:11px}.dropzone>span{font-size:9px;color:#9ba3b1}.dropzone .button{margin-top:7px}.modal-footnote{display:flex;gap:7px;align-items:center;color:#a0a7b4;font-size:9px}.mobile-menu,.mobile-close{display:none}
@media(max-width:1100px){.sidebar{width:225px}.main-area{margin-left:225px}.content{padding:25px 23px}.topbar{padding:0 23px}.metrics-grid{gap:10px}.metric-card{padding:13px}.metric-value{font-size:21px}.dashboard-grid{grid-template-columns:minmax(0,1.4fr) minmax(250px,1fr)}}
@media(max-width:850px){.sidebar{transform:translateX(-100%);transition:transform .22s ease;width:260px}.sidebar.sidebar-open{transform:translateX(0);box-shadow:10px 0 40px #10182745}.mobile-menu,.mobile-close{display:grid}.main-area{margin-left:0}.mobile-menu{margin-right:10px}.topbar{justify-content:flex-start}.breadcrumb{flex:1}.top-actions{gap:9px}.global-search{width:180px}.content{padding:23px 18px}.dashboard-grid{grid-template-columns:1fr}.metrics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.lower-grid{grid-template-columns:1fr}.assistant-layout{grid-template-columns:1fr}.assistant-side{display:none}}
@media(max-width:560px){.topbar{height:58px;padding:0 13px}.global-search{width:35px;border:0;padding:0;overflow:hidden}.global-search input,.global-search kbd{display:none}.top-actions{gap:6px}.content{padding:20px 13px}.page-heading{align-items:flex-start;flex-direction:column;gap:13px}.page-heading h1{font-size:22px}.page-heading>.button{align-self:stretch}.insight-banner{align-items:flex-start;flex-wrap:wrap}.insight-banner button{margin-left:47px}.metrics-grid{gap:9px}.metric-card{padding:12px}.metric-value{font-size:20px}.metric-note{font-size:8px;white-space:normal}.metric-top{font-size:9px}.metric-icon{height:28px;width:28px}.panel{padding:14px}.dashboard-grid{gap:10px}.chart-wrap{height:180px}.chart-foot{flex-direction:column}.attention-item{flex-wrap:wrap}.attention-copy{min-width:calc(100% - 55px)}.attention-item .risk-pill{margin-left:42px}.footer{padding:0 13px}.table-toolbar{align-items:stretch;flex-direction:column}.table-search{width:100%}.toolbar-right{justify-content:space-between}.analysis-steps,.settings-grid,.draft-grid{grid-template-columns:1fr}.analysis-intro{align-items:flex-start;padding:15px}.comparison-selectors{flex-direction:column;width:100%}.comparison-selectors button{width:100%}.assistant-main{padding:23px 14px}.prompt-grid{grid-template-columns:1fr}.assistant-welcome h2{font-size:17px}.footer>span:first-child{display:none}.footer{justify-content:flex-end}.insight-banner p{line-height:1.5}}

.assistant-message {
  background: #f0f4f8;
  color: #172033;
  padding: 16px;
  border-radius: 12px;
  margin: 12px 0;
  max-width: 90%;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.message-label {
  font-size: 11px;
  font-weight: 700;
  margin-bottom: 8px;
  opacity: 0.65;
}

.user-message {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.chat-composer button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.document-selector {
  padding: 16px;
  margin: 16px 0;
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.document-selector label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #64748b;
}

.document-selector select {
  width: 100%;
  padding: 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: white;
  color: #172033;
}

.document-selector small {
  color: #64748b;
  font-size: 12px;
}

.evidence-list {
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid #dbe3ed;
}

.evidence-item {
  margin-top: 10px;
  padding: 12px;
  border: 1px solid #dbe3ed;
  border-radius: 8px;
  background: white;
}

.evidence-item p {
  font-size: 12px;
  line-height: 1.6;
  margin: 7px 0;
  color: #475569;
}

.evidence-item small {
  color: #64748b;
  font-size: 11px;
}

.prompt-grid button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

