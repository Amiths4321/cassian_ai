@app.post("/api/documents/{document_id}/ask")
async def ask_document(document_id: str, request: DocumentAskRequest):
    async with AsyncSessionLocal() as session:
        contract_result = await session.execute(
            select(Contract).where(Contract.id == document_id)
        )
        contract = contract_result.scalar_one_or_none()
        if contract is None:
            raise HTTPException(
                status_code=404,
                detail="Document not found. Please upload or index it again.",
            )

        query_vector = await create_embedding(request.question)
        distance = DocumentChunk.embedding.cosine_distance(query_vector)
        chunk_result = await session.execute(
            select(DocumentChunk, distance.label("distance"))
            .where(DocumentChunk.contract_id == document_id)
            .order_by(distance)
            .limit(8)
        )
        candidates = chunk_result.all()

        # Combine semantic similarity with question-specific keyword relevance.
        stop_words = {
            "what", "which", "when", "where", "who", "why", "how",
            "are", "is", "was", "were", "the", "a", "an", "and",
            "or", "of", "to", "in", "on", "for", "does", "do",
            "this", "that", "it", "under", "according"
        }
        question_terms = {
            term for term in re.findall(r"[a-z0-9]+", request.question.lower())
            if len(term) > 2 and term not in stop_words
        }

        ranked = []
        for chunk, distance_value in candidates:
            text_lower = chunk.chunk_text.lower()
            normalized = " ".join(text_lower.split())
            if not normalized:
                continue

            matched_terms = sum(
                1 for term in question_terms
                if re.search(r"\b" + re.escape(term) + r"\b", text_lower)
            )
            keyword_score = matched_terms / max(len(question_terms), 1)
            semantic_score = max(0.0, 1.0 - float(distance_value))
            combined_score = (0.70 * semantic_score) + (0.30 * keyword_score)

            ranked.append((combined_score, chunk, distance_value, normalized))

        ranked.sort(key=lambda item: item[0], reverse=True)

        retrieved = []
        normalized_seen = set()
        for combined_score, chunk, distance_value, normalized in ranked:
            duplicate = any(
                normalized in existing or existing in normalized
                for existing in normalized_seen
            )
            if duplicate:
                continue

            normalized_seen.add(normalized)
            retrieved.append((chunk, distance_value))
            if len(retrieved) == 2:
                break

        # Copy values before the session closes.
        filename = contract.original_filename
        selected_chunks = [
            (chunk.page_number, chunk.chunk_text, float(distance_value))
            for chunk, distance_value in retrieved
        ]

    if not selected_chunks:
        raise HTTPException(status_code=404, detail="No indexed text chunks were found for this contract.")

    context_parts = []
    sources = []
    for page_number, chunk_text, distance_value in selected_chunks:
        similarity = max(0.0, min(1.0, 1.0 - distance_value))
        context_parts.append(f"[Page {page_number}]\n{chunk_text}")
        sources.append({
            "page": page_number,
            "text": chunk_text,
            "similarity": round(similarity, 4),
        })

    # Built outside the f-string: backslashes inside f-string expressions
    # are a SyntaxError on Python < 3.12.
    evidence_text = "\n\n".join(context_parts)
    user_content = (
        f"Contract filename: {filename}\n\n"
        f"Contract evidence:\n{evidence_text}\n\n"
        f"Question: {request.question}"
    )

    result = await ollama_post(
        "/api/chat",
        {
            "model": CHAT_MODEL,
            "messages": [
                {"role": "system", "content": DOCUMENT_QA_PROMPT},
                {"role": "user", "content": user_content},
            ],
            "stream": False,
            "options": {"temperature": 0, "num_ctx": 8192},
        },
    )

    return {
        "document_id": document_id,
        "filename": filename,
        "model": CHAT_MODEL,
        "question": request.question,
        "answer": result.get("message", {}).get("content", ""),
        "sources": sources,
    }


@app.post("/api/documents/{document_id}/analyse")
async def analyse_document(document_id: str):
    """
    Analyse a complete stored contract, save the analysis,
    and persist individual risk findings.
    """
    from app.clause_extraction import extract_contract_clauses

    async with AsyncSessionLocal() as session:
        contract_result = await session.execute(
            select(Contract).where(Contract.id == document_id)
        )
        contract = contract_result.scalar_one_or_none()

        if contract is None:
            raise HTTPException(status_code=404, detail="Contract not found.")

        chunks_result = await session.execute(
            select(DocumentChunk)
            .where(DocumentChunk.contract_id == document_id)
            .order_by(DocumentChunk.page_number, DocumentChunk.id)
        )
        chunks = chunks_result.scalars().all()

        if not chunks:
            raise HTTPException(status_code=404, detail="No indexed contract text was found.")

        contract_text = "\n\n".join(
            f"[Page {chunk.page_number}]\n{chunk.chunk_text}"
            for chunk in chunks
        )
        filename = contract.original_filename

        try:
            analysis = await analyse_contract(contract_text)
        except Exception as exc:
            traceback.print_exc()
            raise HTTPException(
                status_code=502,
                detail=f"Contract analysis failed: {type(exc).__name__}: {exc}",
            ) from exc

        saved_analysis = ContractAnalysis(
            contract_id=document_id,
            analysis_type="full_contract",
            result=analysis,
        )
        session.add(saved_analysis)

        # Generate the analysis ID before saving linked risks.
        await session.flush()

        risk_items = analysis.get("risk_assessment", [])
        saved_risk_count = 0
        valid_severities = {"low", "medium", "high"}

        for item in risk_items:
            if not isinstance(item, dict):
                continue

            risk = item.get("risk")
            explanation = item.get("explanation")
            evidence = item.get("evidence")

            if not all(
                isinstance(value, str) and value.strip()
                for value in [risk, explanation, evidence]
            ):
                continue

            severity = str(item.get("severity", "medium")).lower()
            if severity not in valid_severities:
                severity = "medium"

            page_number = item.get("page_number")
            if not isinstance(page_number, int):
                page_number = None

            session.add(
                ContractRisk(
                    contract_id=document_id,
                    analysis_id=saved_analysis.id,
                    risk=risk.strip(),
                    severity=severity,
                    explanation=explanation.strip(),
                    evidence=evidence.strip(),
                    page_number=page_number,
                    review_status="pending",
                )
            )
            saved_risk_count += 1

        # Save the analysis and its risks together.
        await session.commit()
        await session.refresh(saved_analysis)

        analysis_id = saved_analysis.id
        analysis_type = saved_analysis.analysis_type
        analysis_result = saved_analysis.result
        created_at = (
            saved_analysis.created_at.isoformat()
            if saved_analysis.created_at else None
        )

    # Extract and persist contract clauses and rules (after the session closes).
    try:
        clause_extraction_result = await extract_contract_clauses(document_id)
    except Exception as exc:
        traceback.print_exc()
        clause_extraction_result = {
            "message": "Analysis saved, but clause extraction failed.",
            "error": str(exc),
            "clauses_saved": 0,
            "rules_saved": 0,
        }

    return {
        "message": "Contract analysed and saved successfully.",
        "document_id": document_id,
        "filename": filename,
        "analysis_id": analysis_id,
        "analysis_type": analysis_type,
        "analysis": analysis_result,
        "risks_saved": saved_risk_count,
        "clause_extraction": clause_extraction_result,
        "created_at": created_at,
    }


@app.get("/api/documents/{document_id}/analysis")
async def get_document_analysis(document_id: str):
    """
