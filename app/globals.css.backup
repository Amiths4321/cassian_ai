.assistant-message {
  background: #f0f4f8;
  color: #172033;
  padding: 16px;
  border-radius: 12px;
  margin: 12px 0;
  max-width: 90%;
  line-height: 1.6;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

/* ContractIQ typography refinement */

.app-shell {
  font-family: var(--font-inter), Inter, sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  color: #17243b;
}

.app-shell h1 {
  font-size: 30px;
  font-weight: 750;
  letter-spacing: -1.1px;
  line-height: 1.2;
}

.app-shell h2 {
  font-size: 23px;
  font-weight: 700;
  letter-spacing: -0.6px;
}

.app-shell h3 {
  font-size: 16px;
  font-weight: 650;
  letter-spacing: -0.25px;
}

.app-shell p {
  line-height: 1.6;
}

.app-shell button,
.app-shell input,
.app-shell select,
.app-shell textarea {
  font-family: inherit;
}

.app-shell .panel {
  border-radius: 14px;
}

.app-shell .text-button {
  font-weight: 650;
}

.brand-home {
  display: flex;
  align-items: center;
  gap: 10px;
  border: 0;
  background: transparent;
  padding: 5px;
  border-radius: 10px;
  text-align: left;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
}

.brand-home:hover {
  background: #f0f8f7;
  transform: translateY(-1px);
}

.brand-home:focus-visible {
  outline: 2px solid #16a394;
  outline-offset: 3px;
}
.message-label {
  font-size: 11px;
  font-weight: 700;
  margin-bottom: 8px;
  opacity: 0.65;
}

.user-message {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.chat-composer button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.document-selector {
  padding: 16px;
  margin: 16px 0;
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.document-selector label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #64748b;
}

.document-selector select {
  width: 100%;
  padding: 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: white;
  color: #172033;
}

.document-selector small {
  color: #64748b;
  font-size: 12px;
}

.evidence-list {
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid #dbe3ed;
}

.evidence-item {
  margin-top: 10px;
  padding: 12px;
  border: 1px solid #dbe3ed;
  border-radius: 8px;
  background: white;
}

.evidence-item p {
  font-size: 12px;
  line-height: 1.6;
  margin: 7px 0;
  color: #475569;
}

.evidence-item small {
  color: #64748b;
  font-size: 11px;
}

.prompt-grid button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}


/* ===== CONTRACTIQ LIGHT ENTERPRISE DASHBOARD ===== */

:root {
  --bg: #f7f9fb;
  --surface: #ffffff;
  --text: #202b3c;
  --muted: #8290a1;
  --line: #e9eef2;
  --purple: #159b89;
  --purple-dark: #108575;
  --nav: #ffffff;
  --nav-muted: #647487;
  --green: #159b89;
  --red: #dc626c;
  --amber: #c68a2e;
}

body {
  background: #f7f9fb;
  color: #202b3c;
  font-family: 'DM Sans', sans-serif;
}

.sidebar {
  background: #ffffff;
  color: #263548;
  border-right: 1px solid #e9eef2;
  box-shadow: 2px 0 8px #172b3b08;
}

.brand-name {
  color: #24364a;
}

.brand-name span {
  color: #159b89;
}

.brand-caption {
  color: #91a0ae;
}

.brand-mark {
  background: linear-gradient(145deg, #27b5a0, #108575);
}

.workspace-switch {
  background: #f5f8fa;
  border: 1px solid #e8eef1;
  color: #334155;
}

.workspace-copy small {
  color: #8492a2;
}

.nav-label {
  color: #9aa7b5;
}

.nav-item {
  color: #627286;
  border-radius: 7px;
}

.nav-item svg {
  color: #8292a2;
}

.nav-item:hover {
  background: #f1f8f7;
  color: #168f81;
}

.nav-item.active {
  background: #e7f5f3;
  color: #118879;
  font-weight: 700;
}

.nav-item.active svg {
  color: #118879;
}

.sidebar-bottom {
  border-color: #e9eef2;
}

.help-card {
  background: #f1f8f7;
  border: 1px solid #e1efed;
  color: #263d4b;
}

.help-card b {
  color: #263d4b;
}

.help-card p {
  color: #748797;
}

.help-card button {
  color: #118879;
}

.profile-row {
  border-top-color: #e9eef2;
}

.profile-copy b {
  color: #334155;
}

.profile-copy small {
  color: #8492a2;
}

.main-area {
  background: #f7f9fb;
}

.topbar {
  background: #ffffff;
  border-bottom-color: #e9eef2;
}

.global-search {
  background: #fafcfd;
  border-color: #e7edf1;
}

.content {
  max-width: 1700px;
}

.page-heading h1 {
  color: #1e2d40;
}

.page-heading p {
  color: #8492a2;
}

.button-primary {
  background: #159b89;
  border-color: #159b89;
  box-shadow: 0 2px 5px #159b891f;
}

.button-primary:hover {
  background: #108575;
}

.metric-card,
.panel {
  border-color: #e9eef2;
  box-shadow: 0 2px 9px #1c35400a;
}

.metric-card:hover,
.panel:hover {
  box-shadow: 0 4px 14px #1c354012;
}

.metric-icon.violet {
  background: #e7f5f3;
  color: #159b89;
}

.metric-icon.green {
  background: #e7f5f0;
  color: #269b78;
}

.chart-foot button,
.text-button {
  color: #159b89;
}

.insight-banner {
  background: #eef8f6;
  border-color: #dcefeb;
}

.insight-spark {
  background: #d9f0eb;
  color: #159b89;
}

.insight-banner b {
  color: #28534c;
}

.insight-banner p {
  color: #748c87;
}

.nav-count {
  background: #fff0ed;
  color: #ce6864;
}

.status-pill.active,
.risk-pill.low {
  background: #e8f6f0;
  color: #238b6b;
}

.footer {
  background: #ffffff;
  border-top-color: #e9eef2;
}

/* Cleaner tables and controls */

th {
  background: #f8fafb;
}

.clickable-row:hover {
  background: #f4faf9;
}

.table-search,
.toolbar-right select,
.select-button {
  border-color: #e5ebef;
}

.table-footer .page-current {
  background: #e7f5f3;
  border-color: #d7ece8;
  color: #118879;
}

/* Keep existing mobile navigation and responsive layouts */

@media (max-width: 850px) {
  .sidebar {
    box-shadow: 10px 0 40px #10182718;
  }
}


/* ===== CONTRACTIQ DASHBOARD VISUAL POLISH ===== */

body {
  font-family: Inter, "Segoe UI", Arial, sans-serif !important;
  color: #243247;
  background: #f6f8fb;
  -webkit-font-smoothing: antialiased;
}

.app-shell {
  font-family: Inter, "Segoe UI", Arial, sans-serif;
}

.page-heading h1 {
  font-size: 30px !important;
  font-weight: 750 !important;
  letter-spacing: -0.8px;
  color: #192b43 !important;
  line-height: 1.25;
}

.page-heading p {
  font-size: 14px !important;
  line-height: 1.6;
  color: #68788c !important;
  margin-top: 7px;
}

.eyebrow {
  font-size: 11px !important;
  font-weight: 700 !important;
  letter-spacing: 1px;
  color: #8291a3 !important;
}

.metrics-grid {
  gap: 16px !important;
  margin-top: 18px;
  margin-bottom: 18px;
}

.metric-card {
  padding: 19px !important;
  min-height: 116px;
  border: 1px solid #e6ebf1 !important;
  border-radius: 12px !important;
  background: #fff !important;
  box-shadow: 0 3px 12px rgba(28, 45, 68, .045) !important;
  transition: transform .18s ease, box-shadow .18s ease;
}

.metric-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 7px 20px rgba(28, 45, 68, .08) !important;
}

.metric-top > span {
  font-size: 13px !important;
  font-weight: 600;
  color: #64748b !important;
}

.metric-value {
  font-size: 30px !important;
  font-weight: 750 !important;
  letter-spacing: -1px;
  color: #192b43 !important;
  margin-top: 9px;
}

.metric-note {
  font-size: 12px !important;
  color: #8491a2 !important;
  margin-top: 5px;
  line-height: 1.5;
}

.panel {
  border: 1px solid #e6ebf1 !important;
  border-radius: 12px !important;
  background: #fff !important;
  box-shadow: 0 3px 12px rgba(28, 45, 68, .04) !important;
}

.panel-heading {
  padding: 19px 20px 13px !important;
}

.panel-heading h3 {
  font-size: 16px !important;
  font-weight: 700 !important;
  color: #24364d !important;
}

.panel-heading p {
  font-size: 13px !important;
  color: #8290a2 !important;
  line-height: 1.5;
  margin-top: 4px;
}

.insight-banner {
  border-radius: 12px !important;
  padding: 16px 19px !important;
  background: #edf8f6 !important;
  border: 1px solid #d9eee9 !important;
  gap: 14px;
}

.insight-banner b {
  font-size: 14px !important;
  font-weight: 700;
  color: #245b53 !important;
}

.insight-banner p {
  font-size: 13px !important;
  color: #607f79 !important;
  line-height: 1.5;
  margin-top: 4px;
}

.insight-banner button {
  font-size: 13px !important;
  font-weight: 650;
  color: #118879 !important;
}

.dashboard-grid {
  gap: 18px !important;
}

.dashboard-grid .panel {
  min-width: 0;
}

.dashboard-grid .panel b {
  font-size: 13px !important;
  color: #293c54;
}

.dashboard-grid .panel small {
  font-size: 12px !important;
  color: #8290a2;
}

.button-primary {
  background: #159b89 !important;
  border-color: #159b89 !important;
  border-radius: 8px !important;
  font-weight: 650 !important;
  box-shadow: 0 2px 5px rgba(21,155,137,.15);
}

.button-primary:hover {
  background: #108575 !important;
}

.text-button {
  font-size: 13px !important;
  font-weight: 650 !important;
  color: #118879 !important;
}

.sidebar .nav-item {
  font-size: 13px !important;
  font-weight: 550;
}

.sidebar .nav-label {
  font-size: 10px !important;
  letter-spacing: 1px;
}

.global-search input {
  font-size: 13px !important;
}

.demo-disclaimer {
  font-size: 11px !important;
  line-height: 1.6;
  color: #8290a2 !important;
  margin-top: 18px;
}

@media (max-width: 1000px) {
  .metrics-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 650px) {
  .page-heading h1 {
    font-size: 24px !important;
  }

  .metrics-grid {
    grid-template-columns: 1fr !important;
  }

  .dashboard-grid {
    grid-template-columns: 1fr !important;
  }

  .insight-banner {
    align-items: flex-start;
    flex-wrap: wrap;
  }
}


/* ===== FINAL CONTRACTIQ RESPONSIVE POLISH ===== */

html, body {
  max-width: 100%;
  overflow-x: hidden;
}

.app-shell,
.main-area,
.content {
  min-width: 0;
  max-width: 100%;
}

.main-area {
  overflow-x: hidden;
}

.content {
  width: 100%;
  box-sizing: border-box;
}

.metrics-grid,
.dashboard-grid {
  width: 100%;
  min-width: 0;
}

.metric-card,
.dashboard-grid > .panel {
  min-width: 0;
  box-sizing: border-box;
}

.metric-card {
  overflow-wrap: anywhere;
}

.dashboard-grid {
  align-items: stretch;
}

.dashboard-grid > .panel {
  min-height: 280px;
}

/* Laptop and smaller desktop screens */
@media (max-width: 1050px) {
  .metrics-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }

  .dashboard-grid {
    grid-template-columns: 1fr !important;
  }

  .page-heading h1 {
    font-size: 26px !important;
  }
}

/* Tablet */
@media (max-width: 850px) {
  .content {
    padding: 20px 16px !important;
  }

  .dashboard-grid {
    gap: 14px !important;
  }

  .metric-card {
    padding: 16px !important;
  }
}

/* Mobile */
@media (max-width: 560px) {
  .metrics-grid {
    grid-template-columns: 1fr !important;
  }

  .page-heading h1 {
    font-size: 23px !important;
  }

  .insight-banner {
    align-items: flex-start;
  }

  .dashboard-grid > .panel {
    min-height: auto;
  }
}

/* Consistent readable workspace text */
.workspace-copy b {
  font-size: 12px;
}

.workspace-copy small {
  font-size: 11px;
}

.nav-item {
  min-height: 36px;
}


/* ===== ORGANISATION SETTINGS ===== */

.settings-intro {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 25px;
  margin-bottom: 26px;
  border: 1px solid #e2ebeb;
  border-radius: 14px;
  background: linear-gradient(120deg, #f5faf9, #ffffff);
}

.settings-intro-mark {
  width: 48px;
  height: 48px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: #e4f1ef;
  color: #236b66;
}

.settings-intro b {
  color: #173b43;
  font-size: 18px;
  font-weight: 700;
}

.settings-intro p {
  margin: 7px 0 0;
  color: #61757a;
  font-size: 14px;
  line-height: 1.65;
}

.settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  align-items: start;
}

.setting-card {
  display: block;
  overflow: hidden;
  padding: 0;
  border: 1px solid #e5ebec;
  border-radius: 14px;
  background: #ffffff;
  box-shadow: 0 3px 12px rgba(24, 55, 60, 0.045);
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.setting-card:hover {
  border-color: #c8dcd9;
  box-shadow: 0 7px 20px rgba(24, 55, 60, 0.08);
}

.setting-card summary {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 23px;
  cursor: pointer;
  list-style: none;
}

.setting-card summary::-webkit-details-marker {
  display: none;
}

.setting-card summary:hover {
  background: #fafaff;
}

.setting-icon {
  width: 46px;
  height: 46px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: #edf5f4;
  color: #286e68;
}

.setting-card-copy {
  flex: 1;
  min-width: 0;
}

.setting-card-copy b {
  color: #173b43;
  font-size: 16px;
  font-weight: 700;
}

.setting-card-copy p {
  margin: 6px 0 10px;
  color: #687b80;
  font-size: 13px;
  line-height: 1.5;
}

.settings-status {
  display: inline-block;
  padding: 5px 10px;
  border-radius: 20px;
  background: #edf4f3;
  color: #376b65;
  font-size: 11px;
  font-weight: 700;
}

.setting-chevron {
  flex-shrink: 0;
  color: #73878a;
  transition: transform 0.2s ease;
}

.setting-card[open] .setting-chevron {
  transform: rotate(90deg);
}

.setting-detail {
  padding: 0 23px 22px;
  border-top: 1px solid #edf1f2;
}

.setting-detail > p {
  margin: 17px 0;
  color: #53686e;
  font-size: 14px;
  line-height: 1.65;
}

.setting-detail span {
  display: block;
  color: #9b762f;
  font-size: 10px;
  margin-bottom: 7px;
}

.setting-detail small {
  display: block;
  margin-top: 17px;
  color: #879497;
  font-size: 11px;
  line-height: 1.5;
}

.settings-item-list {
  display: grid;
}

.settings-live-data {
  padding: 5px 14px;
  margin: 12px 0;
  border-radius: 9px;
  background: #f6f9f9;
}

.settings-data-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18px;
  padding: 15px 2px;
  border-bottom: 1px solid #edf1f2;
  font-size: 12px;
}

.settings-data-row b {
  color: #29464d;
}

.settings-data-row p {
  margin: 4px 0 0;
  color: #7a898d;
  font-size: 11px;
}

.settings-data-row > span {
  color: #78878a;
  font-size: 11px;
  text-align: right;
}

.settings-data-label {
  color: #61747a;
  font-size: 13px;
  line-height: 1.5;
}

.settings-data-row strong {
  color: #203f46;
  font-size: 14px;
  font-weight: 650;
  line-height: 1.5;
  text-align: right;
}

.settings-note {
  margin-top: 18px;
  padding: 15px 17px;
  border-left: 3px solid #6caaa1;
  border-radius: 7px;
  background: #f4f8f7;
}

.settings-note b {
  color: #244c50;
  font-size: 13px;
}

.settings-note p {
  margin: 6px 0 0;
  color: #61747a;
  font-size: 13px;
  line-height: 1.6;
}

@media (max-width: 760px) {
  .settings-grid {
    grid-template-columns: 1fr;
  }

  .setting-card summary {
    padding: 18px;
  }

  .setting-detail {
    padding: 0 18px 18px;
  }
}


/* ===== SYSTEM / GPU STATUS INDICATORS ===== */

.system-status,
.gpu-status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
  padding: 8px 11px;
  border: 1px solid #e5e7eb;
  border-radius: 20px;
  background: #ffffff;
  color: #475569;
  font-size: 12px;
  font-weight: 600;
}

.system-status-light,
.gpu-status-light {
  width: 8px;
  height: 8px;
  min-width: 8px;
  display: inline-block;
  border-radius: 50%;
  background: #94a3b8;
}

.system-online .system-status-light,
.gpu-allocated .gpu-status-light {
  background: #16a34a;
  box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.12);
}

.system-online .system-status-light {
  animation: system-pulse 2s infinite;
}

.system-offline .system-status-light,
.gpu-unavailable .gpu-status-light {
  background: #dc2626;
  box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12);
}

.gpu-idle .gpu-status-light,
.gpu-cpu .gpu-status-light {
  background: #d97706;
  box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.12);
}

.system-checking .system-status-light,
.gpu-checking .gpu-status-light {
  background: #94a3b8;
}

@keyframes system-pulse {
  50% { box-shadow: 0 0 0 7px rgba(22, 163, 74, 0.04); }
}

@media (max-width: 1100px) {
  .system-status,
  .gpu-status {
    padding: 7px 9px;
    font-size: 11px;
  }
}

@media (max-width: 760px) {
  .system-status,
  .gpu-status {
    display: none;
  }
}

/* ContractIQ interactive dashboard cards */
.metric-card-clickable {
  cursor: pointer;
  text-align: left;
  transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
}
.metric-card-clickable:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 22px rgba(30, 64, 175, 0.10);
  border-color: #93B4E8;
}
.metric-card-clickable:focus-visible {
  outline: 3px solid #528BEA;
  outline-offset: 3px;
}

.monitor-stat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 22px rgba(15, 23, 42, .11);
  border-color: #82B9AF !important;
}
.monitor-stat-card:focus-visible {
  outline: 3px solid #149E8F;
  outline-offset: 3px;
}


/* =====================================
   HERONIDP — FINAL SIDEBAR
   (all earlier sidebar/brand iterations merged here)
===================================== */

.app-shell .sidebar,
.app-shell .sidebar * {
  box-sizing: border-box;
}

.app-shell .sidebar {
  display: flex !important;
  flex-direction: column !important;
  width: 230px;
  min-width: 230px;
  height: 100vh;
  height: 100dvh;
  overflow: hidden !important;
  background: #ffffff;
  border-right: 1px solid #e8edf3;
  font-family: var(--font-inter), Inter, sans-serif;
  -webkit-font-smoothing: antialiased;
}

.app-shell .sidebar button {
  font-family: inherit;
}

.app-shell .sidebar span {
  text-rendering: optimizeLegibility;
}

/* Brand */
.brand-mark {
  width: 42px;
  height: 35px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.app-shell .brand {
  flex: 0 0 auto;
  margin: 0 !important;
  padding: 6px 12px 8px !important;
}

.app-shell .brand-home {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 8px;
  width: 100%;
  min-width: 0;
  padding: 0;
  border: none;
  background: transparent;
  text-align: left;
  cursor: pointer;
}

.app-shell .brand-home:hover {
  opacity: 0.85;
}

.app-shell .heronidp-logo-icon {
  display: block;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  object-fit: contain;
}

.app-shell .brand-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
  white-space: normal;
}

.app-shell .brand-name {
  color: #079b8d;
  font-size: 17px;
  font-weight: 750;
  line-height: 1.3;
  letter-spacing: -0.55px;
  white-space: normal;
}

.app-shell .brand-description {
  color: #079b8d;
  font-size: 16px;
  font-weight: 750;
  line-height: 1.25;
  letter-spacing: -0.4px;
}

.app-shell .brand-caption {
  margin-top: 5px;
  color: #8997a9;
  font-size: 9px;
  font-weight: 650;
  letter-spacing: 1.15px;
  white-space: nowrap;
}

/* Workspace switcher */
.app-shell .workspace-switch {
  flex: 0 0 auto;
  margin: 0 10px 5px !important;
  background: #f8fafc;
  border: 1px solid #e8edf3;
  border-radius: 11px;
  font-size: 12px;
  font-weight: 600;
}

.app-shell .workspace-switch small {
  font-size: 10px;
  font-weight: 450;
  color: #8290a4;
}

/* Navigation */
.app-shell .navigation {
  flex: 1 1 auto;
  min-height: 0;
  min-width: 0;
  margin: 0 !important;
  padding: 0 9px 4px !important;
  overflow-x: hidden;
  overflow-y: auto;
  scrollbar-width: none;
}

.app-shell .navigation::-webkit-scrollbar {
  display: none;
}

.app-shell .nav-group {
  margin: 0 !important;
  padding: 0 !important;
}

.app-shell .nav-label {
  margin: 0 !important;
  padding: 7px 9px 3px !important;
  color: #9aa8b8;
  font-size: 9px;
  font-weight: 750;
  line-height: 1.2;
  letter-spacing: 1.15px;
  text-transform: uppercase;
}

.app-shell .nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-width: 0;
  min-height: 32px !important;
  margin: 1px 0 !important;
  padding: 6px 9px !important;
  border-radius: 8px;
  color: #53657b;
  font-weight: 550;
  line-height: 1.3 !important;
  letter-spacing: -0.1px;
  text-align: left;
  transition: background 0.18s ease, color 0.18s ease;
}

.app-shell .nav-item span {
  min-width: 0;
  overflow-wrap: anywhere;
}

.app-shell .nav-item:hover {
  background: #f2f8f7;
  color: #079b8d;
}

.app-shell .nav-item.active {
  background: #e8f5f2;
  color: #078f83;
  font-weight: 700;
}

/* Help / account area — pinned to the bottom */
.app-shell .sidebar-bottom {
  flex: 0 0 auto;
  margin: 4px 9px 8px !important;
  margin-top: auto !important;
  padding: 8px !important;
  background: #f1f8f7;
  border: 1px solid #e0eeeb;
  border-radius: 12px;
  font-size: 11px;
}

.app-shell .sidebar-bottom h4 {
  font-size: 12px;
  font-weight: 700;
}

.app-shell .sidebar-bottom p {
  font-size: 10px;
  line-height: 1.5;
  color: #8190a5;
}

.app-shell .sidebar-bottom a,
.app-shell .sidebar-bottom button {
  font-size: 10px;
  font-weight: 600;
}


/* ============================================
   HERONIDP — FINAL SIDEBAR STYLES
   Consolidated: no duplicate sidebar overrides
============================================ */

.app-shell .sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 252px;
  height: 100vh;
  height: 100dvh;
  display: flex;
  flex-direction: column;
  padding: 10px 10px 8px;
  overflow: hidden;
  background: #ffffff;
  color: #263548;
  border-right: 1px solid #e8edf3;
  box-shadow: 2px 0 8px rgba(23, 43, 59, 0.03);
  z-index: 20;
  font-family: var(--font-inter), Inter, sans-serif;
}

/* Brand at the top */
.app-shell .brand {
  flex: 0 0 auto;
  margin: 0;
  padding: 4px 8px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.app-shell .brand-home {
  display: flex;
  align-items: flex-start;
  width: 100%;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: left;
  cursor: pointer;
}

.app-shell .brand-text {
  min-width: 0;
}

.app-shell .brand-name {
  color: #079b8d;
  font-size: 17px;
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: -0.5px;
}

.app-shell .brand-caption {
  margin-top: 3px;
  color: #8795a8;
  font-size: 8px;
  font-weight: 650;
  letter-spacing: 1px;
}

/* Workspace */
.app-shell .workspace-switch {
  flex: 0 0 auto;
  margin: 0 2px 7px;
  padding: 9px;
  display: flex;
  align-items: center;
  gap: 9px;
  background: #f7f9fc;
  border: 1px solid #e8edf3;
  border-radius: 10px;
}

.app-shell .workspace-copy b {
  color: #34445a;
  font-size: 11px;
  font-weight: 700;
}

.app-shell .workspace-copy small {
  color: #8492a4;
  font-size: 10px;
}

/* Navigation fills the available middle space */
.app-shell .navigation {
  flex: 1 1 auto;
  min-height: 0;
  min-width: 0;
  margin: 0;
  padding: 0 1px 5px;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
}

.app-shell .navigation::-webkit-scrollbar {
  display: none;
}

.app-shell .nav-group {
  margin: 0;
  padding: 0;
}

/* Section headings */
.app-shell .nav-label {
  margin: 0;
  padding: 9px 9px 4px;
  color: #9aa8b8;
  font-size: 9px;
  font-weight: 750;
  letter-spacing: 1.1px;
  line-height: 1.3;
}

/* Navigation links */
.app-shell .nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-height: 34px;
  margin: 1px 0;
  padding: 7px 9px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #596b80;
  font-size: 12px;
  font-weight: 550;
  line-height: 1.3;
  text-align: left;
  transition: background 0.18s ease, color 0.18s ease;
}

.app-shell .nav-item svg {
  flex-shrink: 0;
  color: #8293a8;
}

.app-shell .nav-item span {
  min-width: 0;
}

.app-shell .nav-item:hover {
  background: #f2f8f7;
  color: #078f83;
}

.app-shell .nav-item.active {
  background: #e8f5f2;
  color: #078f83;
  font-weight: 700;
}

.app-shell .nav-item.active svg {
  color: #078f83;
}

/* Help, Preferences and Profile anchored at bottom */
.app-shell .sidebar-bottom {
  flex: 0 0 auto;
  margin: auto 2px 0;
  padding: 5px;
  background: #f1f8f7;
  border: 1px solid #e0eeeb;
  border-radius: 7px;
}

/* Help card */
.app-shell .help-card {
  margin: 0;
  padding: 8px;
  background: #f7fbfa;
  border: 1px solid #e2efed;
  border-radius: 7px;
}

.app-shell .help-card b {
  color: #34485b;
  font-size: 11px;
  font-weight: 700;
}

.app-shell .help-card p {
  margin: 5px 0 9px;
  color: #8493a5;
  font-size: 10px;
  line-height: 1.1;
}

.app-shell .help-card button {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #078f83;
  font-size: 10px;
  font-weight: 650;
}

/* Profile */
.app-shell .profile-row {
  margin-top: 8px;
  padding: 9px 4px 0;
  border-top: 1px solid #e4eeec;
}

.app-shell .profile-copy b {
  color: #34445a;
  font-size: 11px;
}

.app-shell .profile-copy small {
  color: #8492a4;
  font-size: 10px;
}

/* Responsive layout */
@media (max-width: 1100px) {
  .app-shell .sidebar {
    width: 225px;
  }
}

@media (max-width: 850px) {
  .app-shell .sidebar {
    width: 260px;
    transform: translateX(-100%);
    transition: transform 0.22s ease;
  }

  .app-shell .sidebar.sidebar-open {
    transform: translateX(0);
    box-shadow: 5px 0 30px rgba(8, 14, 29, 0.25);
  }
}

/* ===== ContractIQ Enterprise Dashboard Polish ===== */
.app-shell .content {
  background: #f5f8fb;
}

.app-shell .page-heading {
  margin-bottom: 26px;
}

.app-shell .page-heading h1 {
  font-size: 28px !important;
  letter-spacing: -1px;
  color: #172b45 !important;
}

.app-shell .page-heading p {
  font-size: 13px !important;
  color: #718198 !important;
}

.app-shell .insight-banner {
  border-radius: 14px !important;
  padding: 19px 22px !important;
  box-shadow: 0 4px 14px rgba(25, 75, 85, .045);
}

.app-shell .metrics-grid {
  gap: 16px !important;
  margin-top: 20px !important;
}

.app-shell .metric-card {
  border-radius: 14px !important;
  padding: 19px !important;
  min-height: 125px;
  border: 1px solid #e5ebf2 !important;
  box-shadow: 0 3px 12px rgba(28, 45, 68, .035) !important;
}

.app-shell .metric-card:hover {
  transform: translateY(-3px);
  border-color: #cbd9e8 !important;
  box-shadow: 0 9px 24px rgba(28, 45, 68, .075) !important;
}

.app-shell .dashboard-grid {
  gap: 18px !important;
}

.app-shell .dashboard-grid .panel {
  border-radius: 14px !important;
  border-color: #e5ebf2 !important;
  box-shadow: 0 3px 12px rgba(28, 45, 68, .035) !important;
}

@media (max-width: 650px) {
  .app-shell .page-heading h1 {
    font-size: 23px !important;
  }
}

/* ===== ContractIQ Contracts Workspace ===== */
.app-shell .table-panel {
  border: 1px solid #e5ebf2;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 16px rgba(28, 45, 68, .045);
}

.app-shell .table-toolbar {
  padding: 18px 20px;
  gap: 14px;
  background: #fff;
  border-bottom: 1px solid #edf1f5;
}

.app-shell .table-search {
  border-radius: 10px;
  border: 1px solid #e1e8f0;
  background: #f9fbfd;
  min-height: 42px;
}

.app-shell .table-search:focus-within {
  border-color: #8baed4;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, .08);
}

.app-shell .table-panel table {
  border-collapse: separate;
  border-spacing: 0;
  width: 100%;
}

.app-shell .table-panel thead th {
  background: #f7f9fc;
  color: #718198;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: .7px;
  padding: 15px 18px;
}

.app-shell .table-panel tbody td {
  padding: 17px 18px;
  border-bottom: 1px solid #edf1f5;
  color: #475467;
  font-size: 12px;
  vertical-align: middle;
}

.app-shell .table-panel tbody tr {
  transition: background .18s ease;
}

.app-shell .table-panel tbody tr:hover {
  background: #f7faff;
}

.app-shell .table-panel tbody tr:last-child td {
  border-bottom: 0;
}

.app-shell .contract-cell {
  gap: 12px;
}

.app-shell .contract-cell .vendor-avatar {
  border-radius: 10px;
  width: 38px;
  height: 38px;
  flex-shrink: 0;
}

.app-shell .contract-cell span {
  color: #98a2b3;
  font-size: 10px;
  margin-top: 5px;
}

.app-shell .table-panel .status-pill {
  border-radius: 20px;
  padding: 5px 10px;
  font-size: 10px;
  font-weight: 700;
}

.app-shell .demo-disclaimer {
  margin: 14px 18px 18px;
  padding: 11px 13px;
  border-radius: 9px;
  background: #f8fafc;
  color: #718198;
  font-size: 11px;
  line-height: 1.6;
}


/* ===== ContractIQ Risk Intelligence Workspace ===== */
.app-shell .risk-contract-picker,
.app-shell .risk-findings-panel {
  border: 1px solid #e5ebf2;
  border-radius: 15px;
  box-shadow: 0 4px 16px rgba(28, 45, 68, .04);
}

.app-shell .risk-contract-picker {
  background: #fff;
}

.app-shell .risk-contract-picker select,
.app-shell .risk-findings-panel select {
  min-height: 40px;
  border: 1px solid #dfe6ef !important;
  border-radius: 9px !important;
  background: #fbfcfe;
  color: #344054;
  font-size: 12px;
}

.app-shell .risk-finding-card {
  padding: 22px !important;
  transition: background .18s ease;
}

.app-shell .risk-finding-card:hover {
  background: #fbfcff;
}

.app-shell .risk-finding-card > div:first-child b {
  color: #25364b;
  font-size: 14px;
}

.app-shell .risk-finding-card > p {
  color: #475467;
  font-size: 13px !important;
  line-height: 1.75 !important;
}

.app-shell .risk-evidence {
  border: 1px solid #e9e5ff;
  border-left: 3px solid #8173dc !important;
  background: #faf9ff !important;
  border-radius: 0 10px 10px 0 !important;
