/* ===== ContractIQ Commercial Intelligence ===== */
.app-shell .commercial-source-picker,
.app-shell .commercial-results-panel {
  border: 1px solid #e5ebf2;
  border-radius: 15px;
  box-shadow: 0 4px 16px rgba(28, 45, 68, .04);
  overflow: hidden;
}
.app-shell .commercial-source-picker select,
.app-shell .commercial-results-panel input {
  min-height: 42px;
  border: 1px solid #dfe6ef !important;
  border-radius: 9px !important;
  background: #fbfcfe;
  color: #344054;
  font-size: 13px;
}
.app-shell .commercial-results-panel .panel-heading {
  border-bottom: 1px solid #edf1f5;
}
.app-shell .commercial-rule-card {
  padding: 21px !important;
  border: 1px solid #e6ebf2 !important;
  border-radius: 13px !important;
  background: #fff;
  transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
}
.app-shell .commercial-rule-card:hover {
  border-color: #cbd8e8 !important;
  box-shadow: 0 5px 16px rgba(28, 45, 68, .06);
  transform: translateY(-1px);
}
.app-shell .commercial-rule-card strong {
  color: #25364b;
}
.app-shell .commercial-amount {
  padding: 12px 14px;
  border: 1px solid #dcebe5;
  border-radius: 10px;
  background: #f5faf7;
}
.app-shell .commercial-amount > div {
  color: #176b4b;
  overflow-wrap: anywhere;
}
.app-shell .commercial-explanation {
  color: #475467;
  font-size: 14px !important;
  line-height: 1.75 !important;
}
.app-shell .commercial-source-text {
  border: 1px solid #e9e5ff;
  border-left: 3px solid #8173dc !important;
  border-radius: 0 10px 10px 0;
  background: #faf9ff !important;
  color: #475467;
  overflow-wrap: anywhere;
}
@media (max-width: 650px) {
  .app-shell .commercial-rule-card { padding: 15px !important; }
}

/* ===== ContractIQ AI Assistant Polish ===== */
.app-shell .assistant-main,
.app-shell .assistant-side {
  border: 1px solid #e5ebf2;
  box-shadow: 0 6px 24px rgba(28, 45, 68, .045);
}
.app-shell .assistant-main {
  border-radius: 18px;
}
.app-shell .assistant-side {
  border-radius: 15px;
}
.app-shell .assistant-welcome {
  padding-top: 28px;
}
.app-shell .assistant-orb {
  box-shadow: 0 5px 16px rgba(8, 127, 120, .1);
}
.app-shell .document-selector {
  border: 1px solid #e3eaf2;
  border-radius: 12px;
  background: #f8fafc;
}
.app-shell .chat-history {
  gap: 20px;
}
.app-shell .user-message,
.app-shell .assistant-message {
  padding: 17px 19px;
  border-radius: 14px;
  font-size: 14px;
  line-height: 1.8;
}
.app-shell .assistant-message {
  border-color: #e1e8f0;
  box-shadow: 0 4px 14px rgba(28, 45, 68, .045);
}
.app-shell .evidence-item {
  border-radius: 10px;
  background: #f7fafc;
  overflow-wrap: anywhere;
}
.app-shell .prompt-grid button {
  min-height: 52px;
  border-radius: 10px;
  line-height: 1.5;
}
.app-shell .prompt-grid button:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(8, 127, 120, .07);
}
.app-shell .chat-composer {
  position: sticky;
  bottom: 12px;
  z-index: 2;
  border-color: #d8e3eb;
  border-radius: 14px;
  box-shadow: 0 7px 22px rgba(28, 45, 68, .09);
}
.app-shell .chat-composer:focus-within {
  border-color: #159989;
  box-shadow: 0 0 0 3px rgba(21, 153, 137, .1);
}
.app-shell .chat-composer .send-button {
  transition: transform .15s ease, background .15s ease;
}
.app-shell .chat-composer .send-button:hover:not(:disabled) {
  background: #066d67;
  transform: translateY(-1px);
}
@media (max-width: 550px) {
  .app-shell .assistant-main { padding: 14px !important; }
  .app-shell .user-message,
  .app-shell .assistant-message { max-width: 96%; padding: 14px; }
  .app-shell .chat-composer { bottom: 6px; }
}

/* Comparison, drafting and administration workspace refinement */
.comparison-selector-panel,
.comparison-results-panel,
.drafting-contract-panel,
.drafting-editor-panel,
.settings-intro-polished {
  border: 1px solid var(--border, #e7eaf0);
  border-radius: 18px;
  box-shadow: 0 8px 28px rgba(24, 32, 56, .045);
}

.comparison-selector-panel select,
.drafting-contract-panel select,
.drafting-editor-panel textarea {
  transition: border-color .18s ease, box-shadow .18s ease;
}

.comparison-selector-panel select:focus,
.drafting-contract-panel select:focus,
.drafting-editor-panel textarea:focus {
  outline: none;
  border-color: #8273ed !important;
  box-shadow: 0 0 0 3px rgba(130, 115, 237, .13);
}

.comparison-results-panel .panel-heading {
  padding: 20px 20px 12px;
}

.comparison-finding-card {
  background: var(--surface, #fff);
  transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
}

.comparison-finding-card:hover {
  border-color: rgba(130, 115, 237, .45) !important;
  box-shadow: 0 8px 22px rgba(24, 32, 56, .06);
  transform: translateY(-1px);
}

.comparison-side-card {
  min-width: 0;
  border: 1px solid var(--border, #e7eaf0);
}

.comparison-side-card p,
.comparison-finding-card blockquote {
  overflow-wrap: anywhere;
}

.drafting-workflow-grid {
  align-items: stretch;
}

.drafting-workflow-grid .draft-card {
  display: flex;
  flex-direction: column;
  min-height: 220px;
  transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
}

.drafting-workflow-grid .draft-card:hover {
  border-color: rgba(130, 115, 237, .4);
  box-shadow: 0 10px 28px rgba(24, 32, 56, .07);
  transform: translateY(-2px);
}

.drafting-workflow-grid .draft-card .text-button {
  margin-top: auto;
  padding-top: 18px;
}

.drafting-editor-panel form textarea {
  min-height: 130px;
  resize: vertical;
}

.drafting-output {
  overflow-wrap: anywhere;
}

.drafting-output > div {
  border: 1px solid var(--border, #e7eaf0);
  background: var(--surface-secondary, #f7f8fb) !important;
}

.settings-intro-polished {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 22px;
  margin-bottom: 20px;
}

.settings-grid-polished {
  align-items: start;
}

.settings-grid-polished .setting-card {
  overflow: hidden;
  transition: border-color .18s ease, box-shadow .18s ease;
}

.settings-grid-polished .setting-card:hover,
.settings-grid-polished .setting-card[open] {
  border-color: rgba(130, 115, 237, .4);
  box-shadow: 0 8px 24px rgba(24, 32, 56, .055);
}

.settings-grid-polished .setting-card summary {
  cursor: pointer;
  outline: none;
}

.settings-grid-polished .setting-card summary:focus-visible {
  box-shadow: inset 0 0 0 2px #8273ed;
}

.settings-grid-polished .settings-data-row {
  gap: 14px;
  flex-wrap: wrap;
}

.settings-grid-polished .settings-data-row strong {
  overflow-wrap: anywhere;
  text-align: right;
}

@media (max-width: 640px) {
  .comparison-results-panel .panel-heading {
    padding: 16px;
  }

  .comparison-finding-card {
    padding: 13px !important;
  }

  .settings-intro-polished {
    padding: 16px;
  }

  .settings-grid-polished .settings-data-row strong {
    text-align: left;
  }
}
.upload-modal {
  width: min(560px, 100%);
  max-height: min(88vh, 820px);
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: 26px;
  border: 1px solid #e8edf3;
  border-radius: 16px;
}

.modal-backdrop {
  padding: 20px;
  overflow-y: auto;
}

.modal-heading {
  align-items: center;
  padding-bottom: 15px;
  border-bottom: 1px solid #edf0f5;
}

.modal-heading h2 {
  font-size: 19px;
  letter-spacing: -.4px;
}

.modal-heading p {
  font-size: 12px;
}

.upload-modal > div[style*="gridTemplateColumns"] {
  gap: 11px !important;
  margin: 18px 0 !important;
}

.upload-modal > div[style*="gridTemplateColumns"] button {
  min-height: 92px;
  border-radius: 12px !important;
  transition: border-color .18s ease, background .18s ease, transform .18s ease;
}

.upload-modal > div[style*="gridTemplateColumns"] button:hover {
  transform: translateY(-1px);
  border-color: #149f8d !important;
}

.dropzone {
  min-height: 220px;
  margin: 18px 0 15px;
  padding: 25px 16px;
  border: 1.5px dashed #cbd5e1;
  border-radius: 13px;
  background: #f8fbfc;
  transition: border-color .18s ease, background .18s ease;
}

.dropzone:hover {
  border-color: #149f8d;
  background: #f0faf7;
}

.upload-symbol {
  height: 52px;
  width: 52px;
  border-radius: 14px;
  background: #e7f7f2;
  color: #149f8d;
}

.dropzone b {
  font-size: 13px;
  color: #263448;
}

.dropzone > span {
  font-size: 11px;
  color: #78869a;
  text-align: center;
  line-height: 1.6;
}

.upload-modal input:not([type="file"]) {
  width: 100%;
  min-width: 0;
  height: 42px;
  padding: 0 12px;
  border: 1px solid #dce3eb;
  border-radius: 8px;
  outline: none;
  background: #fff;
  color: #263448;
  font-size: 12px;
}

.upload-modal input:focus {
  border-color: #149f8d;
  box-shadow: 0 0 0 3px #149f8d18;
}

.upload-modal form {
  padding: 16px;
  border: 1px solid #edf0f5;
  border-radius: 12px;
  background: #fbfcfd;
}

.upload-modal form button[type="submit"] {
  width: 100%;
  height: 42px;
}

.modal-footnote {
  margin-top: 13px;
  font-size: 10px;
  line-height: 1.5;
}

@media (max-width: 560px) {
  .modal-backdrop {
    padding: 10px;
    align-items: center;
  }

  .upload-modal {
    padding: 18px;
    max-height: 92vh;
    border-radius: 13px;
  }

  .upload-modal > div[style*="gridTemplateColumns"] {
    gap: 8px !important;
  }

  .upload-modal > div[style*="gridTemplateColumns"] button {
    min-height: 82px;
    padding: 10px !important;
  }

  .dropzone {
    min-height: 195px;
    padding: 20px 12px;
  }
}

.obligation-review-editor {
  margin-top: 18px;
  padding: 16px;
  border: 1px solid var(--border-color, #dfe3e8);
  border-radius: 10px;
  background: var(--card-background, #fafafa);
}

.obligation-review-editor textarea {
  width: 100%;
  min-height: 85px;
  padding: 10px;
  border: 1px solid #cbd1d8;
  border-radius: 7px;
  resize: vertical;
  font: inherit;
}

.obligation-review-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.obligation-review-actions button {
  padding: 8px 13px;
  border: 1px solid #cbd1d8;
  border-radius: 7px;
  cursor: pointer;
  font: inherit;
}

.obligation-review-actions button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

@media (max-width: 600px) {
  .obligation-review-actions {
    flex-direction: column;
  }

  .obligation-review-actions button {
    width: 100%;
  }
}

/* Contract repository: keep Actions visible while scrolling */
.app-shell .table-panel .table-scroll {
  overflow-x: auto;
  position: relative;
}
.app-shell .table-panel thead th:last-child,
.app-shell .table-panel tbody td:last-child {
  position: sticky;
  right: 0;
  width: 92px;
  min-width: 92px;
  text-align: center;
  background: #fff;
  box-shadow: -5px 0 8px rgba(20, 30, 50, 0.06);
}
.app-shell .table-panel thead th:last-child {
  background: #f7f9fc;
  z-index: 2;
}
.app-shell .table-panel tbody td:last-child {
  z-index: 1;
}



/* =========================================================
   CONTRACTIQ CLIENT SUBMISSION POLISH — NOV 2026
   Visual-only overrides. Existing React/API behaviour retained.
   ========================================================= */
:root {
  --bg: #f5f7fb;
  --surface: #ffffff;
  --text: #182338;
  --muted: #748198;
  --line: #e7ebf2;
  --purple: #6258d9;
  --purple-dark: #5147c7;
  --nav: #111a2c;
  --nav-muted: #aab5c8;
  --green: #159a78;
  --red: #d65361;
  --amber: #bd812b;
}
html { scroll-behavior: smooth; }
body {
  background: #f5f7fb;
  color: #182338;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
button, input, select, textarea { font-family: inherit; }
button { transition: background .18s ease, border-color .18s ease, color .18s ease, box-shadow .18s ease, transform .18s ease; }
::selection { background: #dedbff; color: #29245f; }
.app-shell { background: #f5f7fb; }
.sidebar {
  background: linear-gradient(180deg, #111a2c 0%, #151e32 100%);
  border-right: 1px solid rgba(255,255,255,.055);
  box-shadow: 8px 0 30px rgba(15,23,42,.06);
}
.brand { padding-bottom: 28px; }
.brand-mark { box-shadow: 0 5px 16px rgba(116,101,223,.25); }
.workspace-switch { background: rgba(255,255,255,.055); border-color: rgba(255,255,255,.09); }
.nav-item { height: 41px; border-radius: 9px; font-size: 12px; }
.nav-item.active {
  background: linear-gradient(100deg, rgba(112,99,224,.28), rgba(112,99,224,.13));
  box-shadow: inset 2px 0 #a79cff;
}
.nav-item:hover { background: rgba(255,255,255,.075); }
.main-area { background: #f5f7fb; }
.topbar {
  height: 66px;
  background: rgba(255,255,255,.94);
  backdrop-filter: blur(14px);
  border-bottom-color: #e8edf4;
  padding-left: clamp(20px, 3vw, 42px);
  padding-right: clamp(20px, 3vw, 42px);
}
.content {
  max-width: 1680px;
  padding: 32px clamp(20px, 3vw, 42px) 30px;
}
.page-heading { margin-bottom: 25px; }
.page-heading h1 { color: #17243a; letter-spacing: -.95px; }
.page-heading p { color: #748198; line-height: 1.65; }
.eyebrow { color: #7772bd; letter-spacing: 1.35px; }
.panel, .metric-card, .analysis-step, .draft-card, .setting-card {
  border-color: #e7ebf2;
  border-radius: 13px;
  box-shadow: 0 3px 14px rgba(24,35,56,.035);
}
.panel { padding: 19px; }
.panel-heading h3, .panel h3 { color: #202d43; }
.button { min-height: 37px; border-radius: 9px; font-size: 11px; }
.button-primary {
  background: linear-gradient(135deg, #7166e5, #5b50ce);
  border-color: #655bd8;
  box-shadow: 0 4px 12px rgba(98,88,217,.18);
}
.button-primary:hover:not(:disabled) {
  background: linear-gradient(135deg, #6258d9, #4f45c3);
  box-shadow: 0 6px 16px rgba(98,88,217,.24);
  transform: translateY(-1px);
}
.button-outline:hover:not(:disabled) {
  color: #5147c7;
  border-color: #c9c4fb;
  background: #faf9ff;
}
.metric-card { padding: 17px 18px; transition: transform .18s ease, box-shadow .18s ease; }
.metric-card:hover { transform: translateY(-2px); box-shadow: 0 9px 24px rgba(24,35,56,.07); }
.metric-value { color: #17243a; }
.insight-banner { border-radius: 12px; padding: 15px 17px; }
.dashboard-grid { gap: 17px; }
.lower-grid { gap: 17px; }
.chart-wrap { min-height: 190px; }
.table-panel { overflow: hidden; }
.table-toolbar { padding: 16px 18px; }
th { background: #f8f9fc; color: #7f8ba0; letter-spacing: .85px; }
td { color: #58657a; }
tbody tr { transition: background .15s ease; }
.clickable-row:hover { background: #f8f8ff; }
.contract-cell b { color: #243149; }
.status-pill, .risk-pill { border-radius: 999px; padding: 5px 9px; font-size: 9px; letter-spacing: .1px; }
.empty-state { border-radius: 12px; line-height: 1.7; }
input, select, textarea {
  transition: border-color .18s ease, box-shadow .18s ease;
}
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: #8d83ed !important;
  box-shadow: 0 0 0 3px rgba(113,102,229,.12);
}
.detail-drawer { box-shadow: -18px 0 50px rgba(15,23,42,.16); }
.detail-drawer-backdrop { backdrop-filter: blur(2px); }
.footer { background: #fff; border-top-color: #e8edf4; }
.demo-disclaimer { line-height: 1.6; }

/* Terms index and clause explorer share the same visual language. */
.content .metrics-grid > div,
.content article,
.content blockquote {
  overflow-wrap: anywhere;
}
.content section.panel {
  border-radius: 13px;
}
.content section.panel > .panel-heading {
  border-bottom: 1px solid #edf0f5;
}
.content textarea { line-height: 1.55; }
.content select, .content input:not([type="checkbox"]):not([type="file"]) {
  min-height: 39px;
  border-color: #dfe5ee;
  border-radius: 9px;
}
.content article {
  border-color: #e6ebf2 !important;
  border-radius: 12px !important;
  box-shadow: 0 2px 10px rgba(24,35,56,.025);
}
.content article:hover { border-color: #d8d5fa !important; }
.content blockquote { border-radius: 8px; }
.content .panel-heading { gap: 14px; }

/* Responsive layout: keep navigation, tables and analytical cards usable. */
@media (max-width: 1100px) {
  .sidebar { width: 220px; }
  .main-area { margin-left: 220px; }
  .content { padding-left: 22px; padding-right: 22px; }
  .topbar { padding-left: 22px; padding-right: 22px; }
  .metrics-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
}
@media (max-width: 760px) {
  .sidebar { width: 66px; padding: 18px 8px 12px; }
  .brand { justify-content: center; padding: 0 0 22px; }
  .brand-name, .brand-caption, .workspace-copy, .workspace-switch > svg,
  .nav-label, .nav-item span, .nav-count, .help-card, .profile-copy,
  .profile-row > svg { display: none !important; }
  .workspace-switch { justify-content: center; padding: 8px 4px; margin-bottom: 18px; }
  .nav-item { justify-content: center; padding: 0; gap: 0; }
  .nav-item svg { width: 18px; height: 18px; }
  .profile-row { justify-content: center; padding: 12px 0 2px; }
  .main-area { margin-left: 66px; }
  .topbar { height: 58px; padding: 0 15px; }
  .global-search { width: min(190px, 45vw); }
  .content { padding: 22px 15px 24px; }
  .page-heading { align-items: flex-start; flex-direction: column; }
  .page-heading h1 { font-size: 22px; }
  .dashboard-grid, .assistant-layout { grid-template-columns: minmax(0,1fr); }
  .analysis-steps, .draft-grid, .settings-grid { grid-template-columns: minmax(0,1fr); }
  .comparison-selectors { flex-wrap: wrap; }
  .footer { padding: 0 15px; }
}
@media (max-width: 480px) {
  .metrics-grid { grid-template-columns: minmax(0,1fr); gap: 9px; }
  .metric-card { padding: 14px; }
  .top-actions { gap: 8px; }
  .global-search { width: 145px; }
  .breadcrumb { font-size: 10px; }
  .content .metrics-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .content .metrics-grid > div { min-width: 0; }
  .table-toolbar { align-items: stretch; flex-direction: column; }
  .table-search { width: 100%; }
  .toolbar-right { flex-wrap: wrap; }
  .footer { height: auto; min-height: 42px; gap: 8px; flex-wrap: wrap; padding-top: 10px; padding-bottom: 10px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
}
