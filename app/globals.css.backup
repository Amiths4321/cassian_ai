  line-height: 1.7;
}

.app-shell .risk-review-notes {
  min-height: 64px;
  background: #fcfdff;
  border-color: #e1e7ef !important;
  border-radius: 9px !important;
  outline: none;
}

.app-shell .risk-review-notes:focus {
  border-color: #91afd2 !important;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, .08);
}

.app-shell .risk-finding-card button {
  min-height: 34px;
  border-radius: 8px !important;
  transition: background .15s ease, border-color .15s ease;
}

.app-shell .risk-finding-card button:hover:not(:disabled) {
  background: #f2f6fb;
  border-color: #aebed1;
}

@media (max-width: 650px) {
  .app-shell .risk-finding-card {
    padding: 16px !important;
  }
}


/* ===== ContractIQ Obligation Management ===== */
.app-shell .obligation-contract-picker,
.app-shell .obligation-results-panel {
