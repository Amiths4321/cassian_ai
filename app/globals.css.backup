  background: #fbfcfe;
  color: #344054;
  font-size: 12px;
}

.app-shell .obligation-results-panel .panel-heading {
  border-bottom: 1px solid #edf1f5;
}

.app-shell .obligation-card {
  padding: 22px !important;
